{
  "name": "agentlab",
  "version": "0.1.0",
  "description": "A plugin-based coding agent for learning how agents work internally (Claude Code style)",
  "type": "module",
  "bin": {
    "agentlab": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "node --import tsx src/cli/index.ts",
    "build": "tsup src/cli/index.ts src/index.ts src/sdk/index.ts --format esm --no-dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p desktop/tsconfig.json",
    "desktop": "node desktop/scripts/run.mjs",
    "desktop:build": "node desktop/scripts/build.mjs",
    "desktop:package": "node desktop/scripts/package.mjs",
    "desktop:smoke": "node desktop/scripts/smoke.mjs",
    "desktop:preview": "node --import tsx desktop/scripts/preview.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:ui-smoke": "node desktop/scripts/ui-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@earendil-works/pi-tui": "^1.0.2",
    "@modelcontextprotocol/sdk": "^1.8.0",
    "chalk": "^6.0.1",
    "ignore": "^7.0.12",
    "minimatch": "^10.0.1",
    "openai": "^4.77.0",
    "tree-sitter": "^0.25.1",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-powershell": "0.26.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.8.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.4",
    "vitest": "^2.1.8"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./src/sdk/index.ts",
      "import": "./dist/sdk/index.js"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
