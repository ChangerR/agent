{
  "name": "agentlab",
  "version": "0.1.0",
  "description": "A plugin-based coding agent for learning how agents work internally (Claude Code style)",
  "type": "module",
  "bin": {
    "agentlab": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "node --import tsx src/cli/index.ts",
    "build": "tsup src/cli/index.ts src/index.ts src/sdk/index.ts --format esm --no-dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@earendil-works/pi-tui": "^1.0.2",
    "@modelcontextprotocol/sdk": "^1.8.0",
    "chalk": "^6.0.1",
    "fast-glob": "^3.3.2",
    "minimatch": "^10.0.1",
    "openai": "^4.77.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./src/sdk/index.ts",
      "import": "./dist/sdk/index.js"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
