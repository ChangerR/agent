{
  "provider": "anthropic",
  "model": "claude-sonnet-4-5",
  "permissionMode": "ask",
  "judgeModel": "",
  "capabilities": { "execution": false },
  "permissions": {
    "allow": [],
    "ask": [],
    "deny": ["bash(git push *)"]
  },
  "maxTurns": 50,
  "compactThreshold": 120000,
  "cache": {
    "enabled": true,
    "ttl": "5m",
    "escalateAfterMs": 0,
    "ttlStrategy": "fixed"
  },
  "mcpConfig": "./mcp.json",
  "pluginEntries": [],
  "pluginConfig": {
    "agentlab.policy": { "writeRoots": [], "resourceRules": [] },
    "agentlab.provider-openai": {
      "dialect": "auto",
      "api": "chat-completions"
    },
    "agentlab.mcp": {
      "maxInlineChars": 24000,
      "maxAgeDays": 30,
      "maxStoredBytes": 268435456,
      "deduplicate": false,
      "maxSearchChars": 1000000
    },
    "agentlab.subagents": {
      "maxRunning": 2,
      "maxDepth": 1,
      "maxTurns": 16,
      "timeoutMs": 300000,
      "maxInbox": 16,
      "maxOutputChars": 131072,
      "previewChars": 8192,
      "maxAgents": 32,
      "maxRuns": 32
    },
    "agentlab.planning": {
      "mode": "auto"
    },
    "agentlab.compaction-summary": {
      "strategy": "isolated"
    }
  },
  "replayToolArguments": false
}
