{
  "provider": "anthropic",
  "model": "claude-sonnet-4-5",
  "permissionMode": "ask",
  "judgeModel": "",
  "permissions": {
    "allow": [],
    "ask": [],
    "deny": ["bash(git push *)"]
  },
  "maxTurns": 50,
  "compactThreshold": 120000,
  "cache": {
    "enabled": true,
    "ttl": "5m",
    "escalateAfterMs": 0
  },
  "mcpConfig": "./mcp.json",
  "pluginEntries": [],
  "pluginConfig": {
    "agentlab.subagents": {
      "maxRunning": 4,
      "maxDepth": 1,
      "maxTurns": 16,
      "timeoutMs": 300000,
      "maxInbox": 16,
      "maxOutputChars": 131072,
      "previewChars": 8192,
      "maxAgents": 32,
      "maxRuns": 32
    }
  }
}
